# Copy to `.env` at the repository root: `cp .env.example .env`
# A single root .env is read by the API, the seed scripts, and Vite (envDir).

# ---------------------------------------------------------------- API
NODE_ENV=development
PORT=4000
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Single-node replica set from docker-compose.yml. directConnection is required
# when connecting from the host to the container's replica set.
MONGO_URI=mongodb://localhost:27017/procurement_intelligence?directConnection=true
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Rate limiter (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# ---- Authentication
# Signs the session JWT (HTTP-only `accessToken` cookie). REQUIRED in production, min 32 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development an insecure built-in secret is used (with a warning) when this is empty.
JWT_SECRET=
# Session lifetime in days
JWT_EXPIRES_DAYS=7
# Max failed logins / signups per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=50

# Max size (MB) of a file uploaded to POST /api/v1/ingestion/jobs
MAX_UPLOAD_MB=10
# Optional. When set, mutating /items routes require header `x-api-key: <value>`.
API_KEY=

# ---------------------------------------------------------------- Web (Vite)
# Base URL of the API. Default "/api/v1" uses the Vite dev proxy.
VITE_API_BASE_URL=/api/v1
# Dev-proxy target for /api
VITE_PROXY_TARGET=http://localhost:4000
# Sent as x-api-key if API_KEY is enabled on the API (dev only; never ship secrets in a browser bundle)
VITE_API_KEY=

# ---------------------------------------------------------------- Seeders
# Seeders reuse MONGO_URI. They refuse to run destructive actions when NODE_ENV=production
# unless ALLOW_DESTRUCTIVE_SEED=true.
ALLOW_DESTRUCTIVE_SEED=false

# ---------------------------------------------------------------- docker-compose
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
