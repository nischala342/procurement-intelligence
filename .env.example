# Copy to `.env` at the repository root: `cp .env.example .env`
# A single root .env is read by the API, the seed scripts, and Vite (envDir).

# ---------------------------------------------------------------- API
NODE_ENV=development
PORT=4000
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Single-node replica set from docker-compose.yml. directConnection is required
# when connecting from the host to the container's replica set.
MONGO_URI=mongodb://localhost:27017/procurement_intelligence?directConnection=true
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Rate limiter (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# ---- Authentication
# Signs the session JWT (HTTP-only `accessToken` cookie). REQUIRED in production, min 32 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development an insecure built-in secret is used (with a warning) when this is empty.
JWT_SECRET=
# Session lifetime in days
JWT_EXPIRES_DAYS=7
# Max failed logins / signups per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=50

# ---- Advisory (Module 5)
# Optional. When set, insight text is written by Claude from the computed evidence only (every number in the output
# is verified against the evidence; anything ungrounded is discarded in favour of the built-in template).
# NOTE: enabling this sends product/vendor names and computed metrics for flagged items to the Anthropic API.
ANTHROPIC_API_KEY=
ADVISORY_MODEL=claude-haiku-5-5
ADVISORY_LLM_TIMEOUT_MS=20000
# Max insights narrated by the LLM per scan (the rest use templates)
ADVISORY_LLM_MAX_PER_RUN=15

# Max size (MB) of a file uploaded to POST /api/v1/ingestion/jobs
MAX_UPLOAD_MB=10
# Optional. When set, mutating /items routes require header `x-api-key: <value>`.
API_KEY=

# ---------------------------------------------------------------- Web (Vite)
# Base URL of the API. Default "/api/v1" uses the Vite dev proxy.
VITE_API_BASE_URL=/api/v1
# Dev-proxy target for /api
VITE_PROXY_TARGET=http://localhost:4000
# Sent as x-api-key if API_KEY is enabled on the API (dev only; never ship secrets in a browser bundle)
VITE_API_KEY=
# Demo mode: shows the seeded demo logins (with password) and sample downloads on the sign-in page.
# Set to false for any deployment that is not a public demo.
VITE_DEMO_MODE=true

# ---------------------------------------------------------------- Seeders
# Seeders reuse MONGO_URI. They refuse to run destructive actions when NODE_ENV=production
# unless ALLOW_DESTRUCTIVE_SEED=true.
ALLOW_DESTRUCTIVE_SEED=false

# ---------------------------------------------------------------- docker-compose
# Mongo and Mongo Express are published on 127.0.0.1 only; the web container is published on WEB_PORT.
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
WEB_PORT=8080
# Mongo Express (profile "tools") basic auth. The password has NO default: the container refuses to start without one.
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
# Full-stack containers (profile "app"): JWT_SECRET above is REQUIRED. docker-compose.yml stores no values: it passes these
# settings through from this file / the platform environment. Unset COOKIE_SECURE means Secure (HTTPS only), so plain
# http://localhost needs COOKIE_SECURE=false; behind HTTPS (e.g. quoteScout.info) set true and CORS_ORIGIN=https://quotescout.info.
COOKIE_SECURE=false
