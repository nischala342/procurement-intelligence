# Rendered by the nginx image at start-up: only ${API_UPSTREAM} and ${CLIENT_MAX_BODY_SIZE} are substituted.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Uploads (ingestion) are capped by the API at MAX_UPLOAD_MB; leave room for multipart overhead.
  client_max_body_size ${CLIENT_MAX_BODY_SIZE};

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain text/csv;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    # an advisory scan can run up to ~2 minutes
    proxy_read_timeout 130s;
  }

  # Demo sample downloads: generated by the seed job into a shared volume, never cached.
  location /samples/ {
    alias /usr/share/nginx/samples/;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
  }

  # Fingerprinted build assets can be cached for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Hash-routed SPA: everything else is the shell (always revalidated).
  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    try_files $uri $uri/ /index.html;
  }
}
